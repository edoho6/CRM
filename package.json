{
  "name": "clinic-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@clinic/web",
    "dev:portal": "turbo run dev --filter=@clinic/portal",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,md,json,css}\"",
    "db:types": "node scripts/db-types.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "a11y:walk": "node scripts/a11y-walk.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^30.0.1",
    "jszip": "3.10.1",
    "mammoth": "1.11.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "sharp": "0.35.4",
    "supabase": "^2.116.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "word-extractor": "1.0.4"
  },
  "pnpm": {
    "overrides": {
      "tar@<7.5.21": "^7.5.21",
      "@capacitor/assets>sharp": "^0.35.4"
    }
  }
}
