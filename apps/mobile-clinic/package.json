{
  "name": "@clinic/mobile-clinic",
  "version": "1.0.0",
  "private": true,
  "description": "The staff app in the stores: a native shell around the live site.",
  "scripts": {
    "prepare:www": "node ../../scripts/mobile-prepare.mjs clinic",
    "sync": "pnpm prepare:www && cap sync",
    "sync:android": "pnpm prepare:www && cap sync android",
    "sync:ios": "pnpm prepare:www && cap sync ios",
    "assets": "capacitor-assets generate --ios --android",
    "clean": "rimraf .turbo node_modules"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "typescript": "5.9.3"
  }
}
