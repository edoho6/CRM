# Copy this file to `.env.local` in the same folder and fill in the two values.
# Find them in your Supabase project under Settings -> API.
#
# Both are public by design: they identify the project and let the browser talk to
# it. Row Level Security is what protects the data, which is why every table in
# supabase/migrations has policies on it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute URL of this app. Used to build email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables the "ask about the data" screen, which lets you ask questions
# about the clinic's own numbers in plain language.
#
# Deliberately NOT a NEXT_PUBLIC_ variable: it is read on the server only and can
# never reach the browser bundle. Leave it unset and the screen says it is not
# configured — nothing else in the app talks to an external service.
#
# Note what this turns on: the question and the results of the query it runs
# (names, dates and numbers) are sent to Anthropic. The contents of clinical
# records, national ID numbers and addresses are never sent — see
# apps/web/features/assistant/queries.ts, which is the closed list of everything
# the assistant can ask of the database.
# ANTHROPIC_API_KEY=sk-ant-...

# Price comparison. The same value as the fetch-shop-prices function's SHOP_PRICES_SECRET;
# with it, "Read now" on /prices/stores starts the reader at once. Without it the request
# waits for the next scheduled round.
SHOP_PRICES_SECRET=
