# Copy this file to `.env.local` in the same folder and fill in the two values.
# Find them in your Supabase project under Settings -> API.
#
# Both are public by design: they identify the project and let the browser talk to
# it. Row Level Security is what protects the data, which is why every table in
# supabase/migrations has policies on it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute URL of this app. Used to build email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
