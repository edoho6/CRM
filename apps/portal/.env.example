# Copy this file to `.env.local` in the same folder.
# Use the SAME Supabase project as the staff app — the portal reads the same
# database, just through the patient-facing Row Level Security policies.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute URL of the portal. Magic-link emails redirect back here, so this must
# match exactly what you add to Supabase -> Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
